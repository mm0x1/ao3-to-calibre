# Copy to .env and fill in. The real .env is ignored by Git, and no tool here
# ever prints, logs, or stores these values.

AO3_USERNAME=
AO3_PASSWORD=

# Optional: the Calibre library the backfill works on. Only `archiver.py` reads
# it, to check the library is reachable and to fill the path into the commands
# it prints; every backfill command still takes --library itself.
CALIBRE_LIBRARY=

# BookOrbit credentials (only if you publish to a BookOrbit library).
# Leave BOOKORBIT_URL empty and everything in this project still works: the
# sync reports that BookOrbit is not configured and stops.
#
# BookOrbit has no API keys. Either sign in with a dedicated account, which is
# the easy option because the sync mints and renews its own token, or paste an
# accessToken, which expires after JWT_EXPIRES_IN (15 minutes by default).
# Give the account only "Edit metadata" and "Download", not admin.
BOOKORBIT_URL=
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
# BOOKORBIT_TOKEN=
# BOOKORBIT_LIBRARY_ID=
